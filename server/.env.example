# PowerBid Backend Environment Configuration Template
# Copy this file to .env and configure the appropriate values for your deployment.

# ========================================================
# 1. Server Core Configuration
# ========================================================
# Port for HTTP & Socket.IO server (Optional, defaults to 3000)
PORT=3000

# Node Environment: 'development', 'production', or 'test' (Optional, defaults to 'development')
NODE_ENV=development

# Allowed CORS Origins: comma-separated list or '*' (Optional, defaults to '*')
CORS_ORIGIN=*

# ========================================================
# 2. PostgreSQL Database Configuration
# ========================================================
# The server automatically falls back to an in-memory database during local development 
# if PostgreSQL is offline or credentials are not supplied.
# In production (or if DB_REQUIRED=true), a valid database connection is strictly required.

# Option A: Full Connection String URL (Recommended for cloud providers like Neon, Supabase, Railway)
# DATABASE_URL=postgresql://powerbid_user:password@localhost:5432/powerbid_prod

# Option B: Discrete Connection Parameters
DB_HOST=localhost
DB_PORT=5432
DB_USER=powerbid_user
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
DB_NAME=powerbid_prod

# Database SSL: 'true' to enable SSL (required for AWS RDS, Neon, Supabase, Render)
DB_SSL=false

# Enforce Database Connection: Set 'true' to crash immediately on startup if DB fails to connect
DB_REQUIRED=false

# ========================================================
# 3. Google Sign-In & OAuth 2.0 Configuration
# ========================================================
# Required for Google ID token verification (used to match token audience claim)
# Web Client ID created in Google Cloud Console
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

# Optional: Android Client ID for secondary audience validation
GOOGLE_ANDROID_CLIENT_ID=REPLACE_WITH_GOOGLE_ANDROID_CLIENT_ID.apps.googleusercontent.com

# ========================================================
# 4. Social & Sharing Configuration
# ========================================================
# Base URL for friend invites and room preview deep links (Optional, defaults to 'https://powerbid.app/invite')
INVITE_BASE_URL=https://powerbid.app/invite

# ========================================================
# 5. Testing & Verification Flags
# ========================================================
# Controls whether mock tokens (mock_google_*, test_google_*) are accepted.
# Automatically enabled in NODE_ENV=test. Strictly rejected in production.
ALLOW_MOCK_OAUTH=false

# ========================================================
# 6. Legacy / Deprecated Integrations
# ========================================================
# NOTE: Facebook Login has been removed from the intended user experience.
# The backend preserves these optional variables solely for backward-compatible
# API contracts with legacy clients. They are NOT required for normal operations.
# FACEBOOK_APP_ID=REPLACE_WITH_FACEBOOK_APP_ID
# FACEBOOK_APP_SECRET=REPLACE_WITH_FACEBOOK_APP_SECRET
