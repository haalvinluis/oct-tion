# ========================================================
# PowerBid Production Environment Variables Template
# ========================================================
# DO NOT commit real secrets to source control.
# Copy this template to .env on your cloud server or set via PaaS environment settings.

# Node Environment & Port
NODE_ENV=production
PORT=3000

# CORS & Network Origin
# Restrict to your registered app domain in production (e.g. https://powerbid.app) or * for mobile
CORS_ORIGIN=*

# PostgreSQL Persistent Database Credentials
# Compatible with Supabase, Neon, AWS RDS, Railway, Render, or Self-Hosted Postgres
# Option A: Full Connection String
# DATABASE_URL=postgresql://powerbid_user:password@your-postgres-host.example.com:5432/powerbid_production?sslmode=require

# Option B: Discrete Parameters
DB_HOST=your-postgres-host.example.com
DB_PORT=5432
DB_NAME=powerbid_production
DB_USER=powerbid_db_user
DB_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
DB_SSL=true
DB_REQUIRED=true

# Google OAuth 2.0 Web Client ID (Required to verify Google ID token audience)
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=REPLACE_WITH_GOOGLE_ANDROID_CLIENT_ID.apps.googleusercontent.com

# Public Deep Link Base URL (Used for generating shareable deep links and invitation web previews)
INVITE_BASE_URL=https://powerbid.app/invite
